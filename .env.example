# Evidence-Capture Session Controller — Environment Variables
# Copy to .env and adjust for your system.
# Source before running:  source .env

# --- Python interpreters ---
# Main interpreter (default: current python3)
# EVCAP_PY=/path/to/python3

# mitmproxy venv interpreter (required for HAR conversion)
# EVCAP_MITM_PY=~/.venvs/mitm/bin/python

# mitmdump binary (default: found next to EVCAP_MITM_PY, then on PATH)
# EVCAP_MITMDUMP=~/.venvs/mitm/bin/mitmdump

# --- Repo root override (default: auto-detected from package location) ---
# EVCAP_HOME=/home/user/One-Way-Video

# --- Firefox ---
# EVCAP_FFOX=/usr/bin/firefox
# EVCAP_FFOX_PROFILE=~/.firefox-mitmproxy

# --- Dump / HAR output dirs ---
# EVCAP_DUMP_DIR=~/One-Way-Video/run/dumps
# EVCAP_HAR_DIR=~/One-Way-Video/run/dumps/processed

# --- PDF signing credentials ---
# Option A: PEM key + cert pair
# EVCAP_KEY_PEM=/path/to/key.pem
# EVCAP_CERT_PEM=/path/to/cert.pem

# Option B: PKCS#12 bundle
# EVCAP_P12=/path/to/cert.p12
# EVCAP_P12_PASS=

# --- PDF signature metadata ---
# EVCAP_SIGN_CONTACT=you@example.com
# EVCAP_SIGN_LOCATION=City, State
# EVCAP_SIGN_REASON=Digitally signed

# --- OBS ---
# EVCAP_OBS_RECORD_DIR=~/Videos
# OBS_HOST=127.0.0.1
# OBS_PORT=4455
# OBS_PASSWORD=

# --- State file overrides (rarely needed) ---
# STATE_JSON_FILE=~/One-Way-Video/run/state.json
# STATE_LOCK_FILE=~/One-Way-Video/run/state.lock

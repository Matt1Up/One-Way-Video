# ---------- OS / editor junk ----------
.DS_Store
Thumbs.db
*.swp
*.swo

# ---------- Python ----------
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env
.env.*

# ---------- Logs / locks / runtime state ----------
*.lock
*.pid
*.sock
*.fifo
*.tmp
*.log

# ---------- Runtime dirs ----------
run/
downloads/
captures/

# Keep placeholders so structure exists
!captures/.gitkeep
!downloads/.gitkeep
!run/.gitkeep
!run/bundles/.gitkeep
!run/dumps/.gitkeep
!run/dumps/processed/.gitkeep
!run/logs/.gitkeep
!run/locks/.gitkeep
!run/web-server/.gitkeep

# Allow web-server SOURCE files to be versioned
!run/web-server/*.py
!run/web-server/*.html
!run/web-server/*.css
!run/web-server/*.js
!run/web-server/*.tsv
!run/web-server/viewer.config.json

# Still ignore web-server generated artifacts
run/web-server/*.json
run/web-server/live_hash_loop.txt
run/web-server/overlay_text.txt

# ---------- Network capture & generated artifacts ----------
*.pcap
*.pcapng
*.har
*.dump
*.jsonl
*.jsonl.zip
network_stream*.txt
http_stream_fifo.txt
network_stream_fifo.txt

# Evidence bundle outputs (restrict to runtime dirs so you can still commit examples elsewhere)
captures/**/*.pdf
downloads/**/*.pdf
run/**/*.pdf
run/**/*.qdf.pdf
run/**/*.ots
run/**/*ots__time-stamp.json

# ---------- Signing keys / certs (very important) ----------
*.pem
*.p12
*.pfx
*.crt
*.cer
*.key
signature/keys/
signature/private/
signature/*.pem
signature/*.p12
signature/*.key

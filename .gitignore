# ---------- OS / editor junk ----------
.DS_Store
Thumbs.db
*.swp
*.swo

# ---------- Local tool settings (contain machine-specific paths) ----------
.claude/
.vscode/
.idea/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# ---------- Secrets ----------
.env
.env.*
!.env.example

# ---------- Logs / locks / runtime state ----------
*.lock
*.pid
*.sock
*.fifo
*.tmp
*.log

# ---------- Runtime dirs ----------
# Ignore the CONTENTS of run/ ("run/*"), never the directory itself ("run/").
# Git cannot re-include a file that lives inside an ignored directory, so the
# old "run/" + "!run/web-server/*.py" pair silently did nothing. Each level
# below un-ignores the directory, then ignores its contents, then keeps .gitkeep.
run/*
!run/bundles/
run/bundles/*
!run/bundles/.gitkeep
!run/dumps/
run/dumps/*
!run/dumps/processed/
run/dumps/processed/*
!run/dumps/processed/.gitkeep
!run/logs/
run/logs/*
!run/logs/.gitkeep
!run/locks/
run/locks/*
!run/locks/.gitkeep
!run/web-server/

# web-server: source is versioned; generated artifacts are not
run/web-server/*.json
!run/web-server/viewer.config.json
run/web-server/live_hash_loop.txt
run/web-server/overlay_text.txt

downloads/*
!downloads/.gitkeep
captures/*
!captures/.gitkeep

# ---------- Network capture & generated artifacts ----------
*.pcap
*.pcapng
*.har
*.dump
*.jsonl
*.jsonl.zip
network_stream*.txt
http_stream_fifo.txt
network_stream_fifo.txt

# Evidence bundle outputs (restricted to runtime dirs so examples/ can still be committed)
captures/**/*.pdf
downloads/**/*.pdf
run/**/*.pdf
run/**/*.qdf.pdf
run/**/*.ots
run/**/*ots__time-stamp.json

# ---------- Signing keys / certs (very important) ----------
*.pem
*.p12
*.pfx
*.crt
*.cer
*.key
signature/keys/
signature/private/
signature/*.pem
signature/*.p12
signature/*.key
